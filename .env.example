# Copy to .env.local for local development. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=https://zbmayuyrwbzlmkauqady.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: email alerts for new contact-form messages (https://resend.com). Leave blank to turn off.
RESEND_API_KEY=
# Who gets the alerts (comma-separated). Blank falls back to the public contact email in Settings.
NOTIFY_TO=
# Sender; must be on a domain verified in Resend (default sandbox sender only reaches the Resend account owner).
NOTIFY_FROM="Vets for Ibogaine <alerts@vetsforibogaine.org>"
